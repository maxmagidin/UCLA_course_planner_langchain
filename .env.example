# Persistent local state
PLANNER_DATABASE_PATH=.data/planner.sqlite3
PLANNER_JOB_WORKERS=2
PLANNER_MAX_QUEUED_JOBS=20
PLANNER_JOB_RETENTION_DAYS=7
# Only enable if you are implementing graph pause/resume and have a retention policy.
PLANNER_PERSIST_GRAPH_CHECKPOINTS=false

# Retrieval controls
PLANNER_MAX_COURSES_PER_DEPARTMENT=12
PLANNER_ENABLE_GRADES=true
PLANNER_ENABLE_HISTORICAL_ENROLLMENT=true
PLANNER_ENABLE_BRUINWALK=true

# Model enhancement is transient BYOK: send provider, api_key, base_url, and
# model in each POST /api/planning/enhance request. The server never owns a key.
# Local deployments may use loopback/host.docker.internal with the custom
# provider. Public deployments require HTTPS and an allow-listed API host.
PLANNER_PUBLIC_DEPLOYMENT=false
MODEL_HOST_ALLOWLIST=

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ucla-course-planner

# Comma-separated browser origins only when the frontend is hosted separately.
FRONTEND_ORIGINS=

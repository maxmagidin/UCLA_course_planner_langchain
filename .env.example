# Persistent local state
PLANNER_DATABASE_PATH=.data/planner.sqlite3
PLANNER_JOB_WORKERS=2
PLANNER_MAX_QUEUED_JOBS=20
PLANNER_JOB_RETENTION_DAYS=7

# Retrieval controls
PLANNER_MAX_COURSES_PER_DEPARTMENT=12
PLANNER_ENABLE_GRADES=true
PLANNER_ENABLE_HISTORICAL_ENROLLMENT=false
PLANNER_ENABLE_BRUINWALK=false

# Optional server-owned model configuration. Direct planning needs no key.
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0

# Optional ASI:One model/legacy compatibility settings.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_AGENT_SEED=replace-with-a-long-random-production-seed
ASI_AGENT_PORT=8001

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ucla-course-planner

# Comma-separated browser origins only when the frontend is hosted separately.
FRONTEND_ORIGINS=

# Local-model escape hatches. Never enable on a public deployment.
ALLOW_INSECURE_MODEL_BASE_URLS=false
ALLOW_PRIVATE_MODEL_BASE_URLS=false

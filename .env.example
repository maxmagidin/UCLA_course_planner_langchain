# Any OpenAI-compatible provider can use these four settings.
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=replace-me
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0
# Optional ASI:One preset: MODEL_PROVIDER=asi_one
ASI_ONE_API_KEY=replace-me
ASI_ONE_MODEL=asi1
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_ENABLE_THINKING=false
ASI_AGENT_SEED=replace-with-a-long-random-production-seed
ASI_AGENT_PORT=8001
# Local planner performance/coverage controls
PLANNER_MAX_COURSES_PER_DEPARTMENT=12
PLANNER_ENABLE_GRADES=true
PLANNER_ENABLE_HISTORICAL_ENROLLMENT=false
PLANNER_ENABLE_BRUINWALK=false
# Comma-separated browser origins only when frontend and API are deployed separately.
# FRONTEND_ORIGINS=https://maxmagidin.github.io
# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=ucla-course-planner
